rules_version = '2';
// Prototype-level rules (§10). All writes go through the backend (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /restaurants/{id} {
      allow read: if true;
    }
    match /audits/{id} {
      // The planned check list lives in auditSecrets, so audit docs hold nothing secret.
      allow read: if request.auth != null;
      match /findings/{fid} {
        allow read: if request.auth != null;
      }
    }
    match /orders/{id} {
      allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
    }
    match /auditSecrets/{id} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow write: if false;
    }
  }
}
